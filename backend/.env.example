# ============================================================================
# Re-Hardwire Backend Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values.
# ============================================================================

# --- App Environment ---
APP_ENV=development
APP_NAME=Re-Hardwire Backend
APP_VERSION=1.0.0

# --- Database ---
# SQLite for local dev: sqlite+aiosqlite:///./data/dev.db
# PostgreSQL for production: postgresql+psycopg2://user:pass@host:5432/db
DATABASE_URL=sqlite+aiosqlite:///./data/dev.db
FIELD_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key-here

# --- OIDC Provider Configuration (Task 1.2) ---
# Configure your preferred OIDC/OAuth2 identity provider:

# Provider name (Auth0, Firebase, Keycloak, Cognito, custom)
OIDC_PROVIDER_NAME=Auth0

# OIDC Issuer (e.g. https://your-tenant.auth0.com/)
OIDC_ISSUER=https://your-tenant.auth0.com/

# OAuth2 Client ID (from your identity provider console)
OIDC_CLIENT_ID=your-client-id

# OAuth2 Client Secret (from your identity provider console)
OIDC_CLIENT_SECRET=your-client-secret

# Authorization endpoint
OIDC_AUTH_ENDPOINT=https://your-tenant.auth0.com/authorize

# Token endpoint
OIDC_TOKEN_ENDPOINT=https://your-tenant.auth0.com/oauth/token

# Userinfo endpoint
OIDC_USERINFO_ENDPOINT=https://your-tenant.auth0.com/userinfo

# JWKS endpoint
OIDC_JWKS_URI=https://your-tenant.auth0.com/.well-known/jwks.json

# Token revocation endpoint (Auth0 uses /oauth/revoke)
OIDC_REVOCATION_ENDPOINT=https://your-tenant.auth0.com/oauth/revoke

# Session token TTL (seconds)
AUTH_TOKEN_TTL=86400
AUTH_SESSION_TTL=2592000
AUTH_REFRESH_GRACE=604800

# --- Frontend CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Language Model ---
LLM_PROVIDER=local
LLM_MODEL=phi3:mini
LLM_BASE_URL=http://localhost:11434
LLM_TIMEOUT=120
LLM_MAX_TOKENS=256

# --- TTS ---
TTS_VOICE=re-hardwire-core
TTS_SPEED=1.0
TTS_WORDS_PER_MINUTE=150

# --- Other ---
DEFAULT_PROTOCOL=Resilience Builder Level 3
HISTORY_LIMIT=100

# ============================================================================
# IMPORTANT: The .env file is for local development only.
# Never commit .env to version control.
# ============================================================================