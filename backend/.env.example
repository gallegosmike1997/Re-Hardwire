# Optional local backend settings. Never commit a real key in this file.
APP_ENV=development
LLM_PROVIDER=local
LLM_MODEL=re-hardwire-local
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT=20
LLM_MAX_TOKENS=1024

# Local web development origins. Add only origins you control.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional for local development. A configured value must be at least 32 characters.
# Production multi-user auth requires a stable random value from a secret manager.
AUTH_SECRET=

# Optional data directory; defaults to backend/data.
# RE_HARDWIRE_DATA_DIR=./data
