# Optional local backend settings. Never commit a real key in this file.
LLM_PROVIDER=local
LLM_MODEL=re-hardwire-local
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT=20
LLM_MAX_TOKENS=1024

# Local web development origins. Add only origins you control.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set a unique, randomly generated value before using auth tokens outside local development.
AUTH_SECRET=replace-with-a-long-random-secret

# Optional data directory; defaults to backend/data.
# RE_HARDWIRE_DATA_DIR=./data
