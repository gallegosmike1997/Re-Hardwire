# Copy to .env.local for local/native development against a running backend.
#
# Emulator/device note: Chromium's Local Network Access protection blocks the
# WebView from reaching the private host alias http://10.0.2.2:8000. Use
# loopback instead and run `npm run android:link` (adb reverse) so the device's
# localhost:8000 forwards to this machine's localhost:8000. This value is only
# read by `next build`/`next dev`; leave it empty (or unset) for offline-first
# production builds, which make no backend calls. Never put provider secrets
# here -- this file is bundled into the frontend and is public.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
