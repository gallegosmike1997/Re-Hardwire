<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network security configuration.

  The release APK ships without this overlay, so its cleartext policy stays at
  the platform default (blocked) and it never talks to a development backend.
  In debug builds this permits cleartext HTTP to the emulator loopback (10.0.2.2)
  or the host machine. The Capacitor WebView is served from http://localhost
  (see capacitor.config.ts), so mixed content is not a concern; this config
  only grants the OS-level cleartext permission the request needs, and every
  other origin remains blocked.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator alias for the host machine's localhost. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Genymotion / physical device over adb reverse and direct loopback. -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
