<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay. The Android manifest merger applies these
  attributes to debug builds only; the release manifest is unaffected, so the
  published APK keeps cleartext traffic blocked and never loads this config.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true" />

</manifest>
